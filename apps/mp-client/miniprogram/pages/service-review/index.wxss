.page {
  padding-bottom: 154rpx;
}

.review-header {
  margin-top: 8rpx;
  position: relative;
  overflow: hidden;
  border-color: rgba(216, 183, 106, 0.18);
  background:
    radial-gradient(circle at 86% 0%, rgba(145, 216, 255, 0.14), transparent 34%),
    linear-gradient(145deg, rgba(9, 22, 25, 0.96), rgba(3, 8, 10, 0.94));
}

.header-copy {
  margin-top: 18rpx;
  color: #b8c3d2;
  font-size: 23rpx;
  line-height: 1.6;
}

.page-state {
  margin-top: 28rpx;
}

.skeleton-line {
  height: 26rpx;
  margin: 14rpx 0;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(246, 234, 208, 0.08), rgba(246, 234, 208, 0.18), rgba(246, 234, 208, 0.08));
}

.skeleton-line.short {
  width: 58%;
}

.summary-head,
.assistant-head,
.follow-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.order-no {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

.review-privacy-note {
  margin-top: 18rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(145, 216, 255, 0.14);
  border-radius: 14rpx;
  background: rgba(3, 12, 20, 0.58);
  color: #9eb0c2;
  font-size: 21rpx;
  line-height: 1.55;
}

.info-line {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 12rpx 0;
  color: #d8cfb6;
  font-size: 23rpx;
}

.info-line text:last-child {
  color: #ffffff;
  text-align: right;
}

.locked-card .btn,
.submitted-card .btn {
  margin-top: 24rpx;
}

.submitted-card {
  text-align: center;
}

.submitted-score {
  margin-top: 20rpx;
  color: #f6e9c6;
  font-size: 84rpx;
  line-height: 1;
  font-weight: 500;
}

.submitted-comment {
  margin-top: 22rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(246, 234, 208, 0.08);
  border-radius: 14rpx;
  background: rgba(5, 13, 24, 0.62);
  color: #d8cfb6;
  font-size: 23rpx;
  line-height: 1.7;
  text-align: left;
}

.score-card {
  border-color: rgba(216, 183, 106, 0.16);
}

.score-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.score-number {
  display: grid;
  place-items: center;
  width: 86rpx;
  height: 86rpx;
  border: 1rpx solid rgba(216, 183, 106, 0.28);
  border-radius: 50%;
  background: rgba(216, 183, 106, 0.12);
  color: #f6e9c6;
  font-size: 34rpx;
  font-weight: 700;
}

.rating-list {
  margin-top: 20rpx;
}

.rating-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(246, 234, 208, 0.07);
  color: #d8cfb6;
  font-size: 24rpx;
}

.rating-row.featured {
  padding-top: 20rpx;
}

.rating-title {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
}

.rating-hint {
  margin-top: 6rpx;
  color: #8b98aa;
  font-size: 20rpx;
  line-height: 1.35;
}

.stars {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.star {
  color: rgba(246, 234, 208, 0.28);
  font-size: 34rpx;
  line-height: 1;
}

.star.active {
  color: #d8b76a;
}

.assistant-review {
  margin-top: 18rpx;
  padding: 20rpx;
  border-bottom: 1rpx solid rgba(246, 234, 208, 0.08);
  border: 1rpx solid rgba(246, 234, 208, 0.08);
  border-radius: 16rpx;
  background: rgba(5, 13, 24, 0.54);
}

.assistant-review:last-child {
  border-bottom: 1rpx solid rgba(246, 234, 208, 0.08);
}

.assistant-head {
  justify-content: flex-start;
}

.assistant-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: rgba(246, 234, 208, 0.08);
}

.assistant-name {
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 600;
}

.assistant-stars {
  margin-top: 0;
}

.assistant-score-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
}

.assistant-score {
  color: #d8cfb6;
  font-size: 21rpx;
  white-space: nowrap;
}

.assistant-comment,
.main-comment {
  margin-top: 18rpx;
}

.review-tags {
  margin-top: 20rpx;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.review-section-copy {
  margin-top: 10rpx;
}

.tag.selectable {
  border: 1rpx solid rgba(246, 234, 208, 0.08);
  background: rgba(246, 234, 208, 0.06);
  color: #aeb8c6;
}

.tag.selectable.active {
  border-color: rgba(216, 183, 106, 0.36);
  background: rgba(216, 183, 106, 0.16);
  color: #e2c77e;
}

.follow-row {
  margin-top: 24rpx;
}

.repurchase-block {
  margin-top: 24rpx;
}

.repurchase-options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 14rpx;
}

.repurchase-option {
  height: 60rpx;
  border: 1rpx solid rgba(246, 234, 208, 0.08);
  border-radius: 14rpx;
  background: rgba(5, 13, 24, 0.62);
  color: #aeb8c6;
  font-size: 22rpx;
  line-height: 60rpx;
  text-align: center;
}

.repurchase-option.active {
  border-color: rgba(216, 183, 106, 0.36);
  background: rgba(216, 183, 106, 0.16);
  color: #e2c77e;
}

.follow-title {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
}

.review-actions {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}
