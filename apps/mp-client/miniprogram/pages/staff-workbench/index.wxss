.header-card {
  margin-top: 8rpx;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 24rpx;
}

.metric-card {
  min-height: 112rpx;
  padding: 18rpx 12rpx;
  border: 1rpx solid rgba(246, 234, 208, 0.08);
  border-radius: 14rpx;
  background: rgba(10, 18, 29, 0.9);
}

.metric-value {
  color: #f6e9c6;
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1;
}

.metric-label {
  margin-top: 12rpx;
  color: #8b98aa;
  font-size: 19rpx;
  line-height: 1.25;
}

.work-card + .work-card {
  margin-top: 18rpx;
}

.work-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.work-title {
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
}

.info-line {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 10rpx 0;
  color: #d8cfb6;
  font-size: 23rpx;
}

.info-line text:last-child {
  color: #ffffff;
  text-align: right;
}

.work-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 20rpx;
}

.check-actions {
  margin-top: 12rpx;
}

.service-btn {
  height: 64rpx;
  border: 1rpx solid rgba(246, 234, 208, 0.1);
  border-radius: 14rpx;
  background: rgba(5, 13, 24, 0.68);
  color: #d8cfb6;
  font-size: 22rpx;
}

.service-btn.primary {
  border-color: rgba(216, 183, 106, 0.36);
  background: rgba(216, 183, 106, 0.16);
  color: #e2c77e;
}

.service-btn.disabled {
  opacity: 0.58;
}
