.home-hero {
  position: relative;
  min-height: 620rpx;
  padding: 0;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  border-color: rgba(176, 138, 58, 0.32);
  background: #03080a;
}

.hero-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.hero-shade {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(2, 5, 6, 0.02) 0%, rgba(2, 5, 6, 0.28) 42%, rgba(2, 5, 6, 0.96) 100%),
    linear-gradient(90deg, rgba(2, 5, 6, 0.9) 0%, rgba(2, 5, 6, 0.48) 48%, rgba(2, 5, 6, 0.1) 100%);
}

.hero-content {
  position: relative;
  z-index: 1;
  width: 100%;
  box-sizing: border-box;
  padding: 176rpx 30rpx 32rpx;
}

.home-hero .h1 {
  max-width: 430rpx;
}

.home-brand-logo {
  width: 520rpx;
  max-width: 100%;
  height: 128rpx;
  margin-bottom: 26rpx;
}

.home-brand-logo-image {
  display: block;
  width: 100%;
  height: 100%;
}

.hero-eyebrow {
  color: #d6c894;
}

.hero-copy {
  margin-top: 18rpx;
  max-width: 430rpx;
  color: #ded7c2;
  font-size: 24rpx;
  line-height: 1.62;
}

.hero-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 30rpx;
}

.service-matrix {
  border-color: rgba(176, 138, 58, 0.22);
}

.matrix-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.matrix-item {
  position: relative;
  min-height: 132rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(246, 234, 208, 0.08);
  border-radius: 14rpx;
  overflow: hidden;
  background: rgba(5, 13, 24, 0.55);
}

.matrix-item.primary {
  border-color: rgba(216, 183, 106, 0.28);
}

.matrix-item.wide {
  grid-column: 1 / -1;
}

.matrix-bg,
.matrix-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.matrix-bg {
  opacity: 0.68;
}

.matrix-shade {
  background:
    linear-gradient(180deg, rgba(2, 5, 6, 0.08), rgba(2, 5, 6, 0.72)),
    linear-gradient(90deg, rgba(2, 5, 6, 0.74), rgba(2, 5, 6, 0.18));
}

.matrix-content {
  position: relative;
  z-index: 1;
}

.matrix-title {
  color: #fff6de;
  font-size: 24rpx;
  font-weight: 650;
}

.matrix-item .muted {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.48;
}

.home-assurance {
  border-color: rgba(176, 138, 58, 0.24);
}

.compact-head {
  margin-bottom: 18rpx;
}

.assurance-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.assurance-item {
  min-height: 144rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(246, 234, 208, 0.07);
  border-radius: 14rpx;
  background: rgba(5, 13, 24, 0.55);
}

.assurance-no {
  color: #b08a3a;
  font-size: 18rpx;
  letter-spacing: 2rpx;
}

.assurance-title {
  margin-top: 10rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
}

.assurance-item .muted {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.45;
}

.link {
  color: #c9a85c;
  font-size: 24rpx;
}

.scene-scroll {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
}

.scene-mini {
  flex: 0 0 388rpx;
  padding: 0;
  overflow: hidden;
}

.scene-cover {
  width: 100%;
  height: 176rpx;
}

.scene-name {
  padding: 18rpx 20rpx 6rpx;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
}

.clamp {
  padding: 0 20rpx 20rpx;
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.assistant-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
  background: #071316;
}

.assistant-info {
  flex: 1;
  min-width: 0;
}

.assistant-title {
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
}

.compact {
  margin-top: 12rpx;
}

.compact .tag {
  padding: 7rpx 12rpx;
}

.compliance {
  border-color: rgba(176, 138, 58, 0.28);
}

.compliance .muted {
  margin-top: 18rpx;
}
