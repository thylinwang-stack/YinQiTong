.header-card {
  position: relative;
}

.order-no {
  margin-bottom: 14rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.header-card .status-pill {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
}

.timeline {
  margin-top: 14rpx;
}

.step {
  display: flex;
  gap: 12rpx;
  position: relative;
  padding-bottom: 18rpx;
}

.step::before {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 22rpx;
  bottom: 0;
  width: 2rpx;
  background: rgba(246, 234, 208, 0.1);
}

.step:last-child::before {
  display: none;
}

.dot {
  width: 18rpx;
  height: 18rpx;
  margin-top: 5rpx;
  border-radius: 50%;
  background: #39465a;
}

.step.done .dot {
  background: #c9a85c;
}

.step-content {
  flex: 1;
}

.step-name {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
}

.assurance-panel .muted {
  margin-top: 10rpx;
}

.assurance-list {
  display: grid;
  gap: 14rpx;
  margin-top: 20rpx;
}

.assurance-item {
  padding: 16rpx;
  border: 1rpx solid rgba(246, 234, 208, 0.08);
  border-radius: 16rpx;
  background: rgba(5, 13, 24, 0.56);
}

.assurance-item.done {
  border-color: rgba(216, 183, 106, 0.18);
}

.assurance-item.doing {
  border-color: rgba(70, 145, 255, 0.2);
}

.assurance-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.assurance-title {
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 600;
}

.assurance-status {
  color: #d8b76a;
  font-size: 20rpx;
  white-space: nowrap;
}

.info-line {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 14rpx 0;
  color: #d8cfb6;
  font-size: 24rpx;
}

.info-line text:last-child {
  color: #ffffff;
  text-align: right;
}

.gold-text {
  color: #e2c77e !important;
  font-weight: 700;
}

.assistant-summary-list {
  display: grid;
  gap: 14rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(246, 234, 208, 0.08);
}

.assistant-summary {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.assistant-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 16rpx;
  background: rgba(246, 234, 208, 0.08);
}

.assistant-name {
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 600;
}

.compliance {
  margin-bottom: 0;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.review-panel .muted {
  margin-top: 12rpx;
}

.review-actions-inline {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 22rpx;
}

.service-btn.primary {
  border-color: rgba(216, 183, 106, 0.36);
  background: rgba(216, 183, 106, 0.16);
  color: #e2c77e;
}

.service-btn.disabled {
  opacity: 0.56;
}

.service-panel {
  margin-bottom: 126rpx;
}

.service-panel .muted {
  margin-top: 10rpx;
}

.service-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 20rpx;
}

.service-btn {
  height: 68rpx;
  border: 1rpx solid rgba(246, 234, 208, 0.1);
  border-radius: 14rpx;
  background: rgba(5, 13, 24, 0.68);
  color: #d8cfb6;
  font-size: 23rpx;
}

.service-btn.danger {
  border-color: rgba(255, 117, 117, 0.32);
  color: #ffb4b4;
}

.actions {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.empty {
  margin-top: 80rpx;
  color: #d8cfb6;
  text-align: center;
}
