.scene-hero {
  position: relative;
  min-height: 520rpx;
  padding: 0;
  overflow: hidden;
}

.scene-cover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.scene-mask {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(2, 5, 6, 0.02) 0%, rgba(2, 5, 6, 0.42) 44%, rgba(2, 5, 6, 0.96) 100%),
    linear-gradient(90deg, rgba(2, 5, 6, 0.82), rgba(2, 5, 6, 0.16));
}

.scene-copy {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 28rpx;
}

.scene-copy .muted {
  margin-top: 16rpx;
  color: #ded7c2;
}

.scene-tags {
  margin-top: 18rpx;
}

.scope-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.scope-item {
  display: flex;
  gap: 10rpx;
  align-items: flex-start;
  min-height: 72rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  background: rgba(5, 13, 24, 0.58);
  color: #d8cfb6;
  font-size: 22rpx;
  line-height: 1.45;
}

.scope-dot {
  flex-shrink: 0;
  width: 10rpx;
  height: 10rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #d8b76a;
}

.process-item {
  display: flex;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(246, 234, 208, 0.08);
}

.process-item:last-child {
  border-bottom: 0;
}

.process-no {
  flex-shrink: 0;
  color: #b08a3a;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.process-title {
  margin-bottom: 8rpx;
  color: #fff6de;
  font-size: 25rpx;
  font-weight: 650;
}

.package-preview {
  border-color: rgba(216, 183, 106, 0.2);
}

.compact-head {
  margin-bottom: 14rpx;
}

.package-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.package-name {
  margin-bottom: 8rpx;
  color: #fff6de;
  font-size: 27rpx;
  font-weight: 650;
}

.price {
  color: #e2c77e;
  font-size: 32rpx;
  font-weight: 700;
}

.link {
  color: #c9a85c;
  font-size: 24rpx;
}

.assistant-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.avatar {
  width: 112rpx;
  height: 132rpx;
  border-radius: 16rpx;
  background: #071316;
}

.assistant-info {
  flex: 1;
  min-width: 0;
}

.assistant-title {
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
}

.mini-talents {
  margin-top: 10rpx;
  color: #e2c77e;
  font-size: 20rpx;
  line-height: 1.45;
}

.compact {
  margin-top: 12rpx;
}

.compact .tag {
  padding: 7rpx 12rpx;
}

.scene-actions {
  position: sticky;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: 0.86fr 1.14fr;
  gap: 14rpx;
  margin-top: 34rpx;
  padding: 18rpx 0 4rpx;
  background: linear-gradient(180deg, rgba(2, 6, 7, 0), #020607 28%);
}
