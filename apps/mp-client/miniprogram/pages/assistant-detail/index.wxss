.profile-hero {
  position: relative;
  min-height: 640rpx;
  padding: 0;
  overflow: hidden;
  border-color: rgba(216, 183, 106, 0.24);
  background: #071316;
}

.portrait {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  filter: saturate(0.96) contrast(1.02);
}

.profile-shade {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(2, 5, 6, 0.02) 0%, rgba(2, 5, 6, 0.16) 38%, rgba(2, 5, 6, 0.92) 100%),
    linear-gradient(90deg, rgba(2, 5, 6, 0.72), rgba(2, 5, 6, 0.08) 54%, rgba(2, 5, 6, 0.36));
}

.profile-pills {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.profile-main {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 1;
}

.name-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.name-row .h1 {
  margin-top: 0;
}

.city {
  color: #d8cfb6;
  font-size: 24rpx;
  white-space: nowrap;
}

.profile-quote {
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(216, 183, 106, 0.2);
  border-radius: 16rpx;
  background: rgba(3, 8, 10, 0.58);
  color: #fff0c8;
  font-size: 25rpx;
  line-height: 1.58;
}

.profile-main .tag-row {
  margin-top: 18rpx;
}

.profile-signal-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 20rpx;
}

.profile-signal {
  min-height: 104rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(246, 234, 208, 0.08);
  border-radius: 16rpx;
  background: rgba(5, 13, 24, 0.62);
}

.profile-signal view {
  color: #9aa195;
  font-size: 18rpx;
  line-height: 1.35;
}

.profile-signal text {
  display: block;
  margin-top: 10rpx;
  color: #fff6de;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 600;
}

.recommend-box {
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(216, 183, 106, 0.2);
  border-radius: 16rpx;
  background: rgba(216, 183, 106, 0.08);
  color: #f0e2bd;
  font-size: 24rpx;
  line-height: 1.7;
}

.block {
  margin-top: 22rpx;
}

.skill-list {
  margin-top: 14rpx;
  color: #d8cfb6;
  font-size: 24rpx;
  line-height: 1.75;
}

.capability-list {
  display: grid;
  gap: 12rpx;
  margin-top: 16rpx;
}

.capability-item {
  display: grid;
  grid-template-columns: 52rpx 1fr;
  gap: 16rpx;
  align-items: center;
  padding: 16rpx;
  border: 1rpx solid rgba(216, 183, 106, 0.16);
  border-radius: 14rpx;
  background: rgba(5, 13, 24, 0.58);
}

.capability-item text {
  color: #b08a3a;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.capability-item view {
  color: #f1e2bd;
  font-size: 23rpx;
  line-height: 1.55;
}

.compliance {
  margin-bottom: 116rpx;
  border-color: rgba(216, 183, 106, 0.22);
}

.privacy {
  margin-top: 16rpx;
}

.fixed-btn {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.empty {
  margin-top: 80rpx;
  color: #d8cfb6;
  text-align: center;
}
