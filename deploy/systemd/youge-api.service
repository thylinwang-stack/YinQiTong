[Unit]
Description=Youge Fanjv NestJS API
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/youge-fanjv/apps/api
EnvironmentFile=/etc/youge-fanjv/api.env
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=5
User=youge
Group=youge

[Install]
WantedBy=multi-user.target
